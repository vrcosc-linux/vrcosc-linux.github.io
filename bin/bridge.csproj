<!-- Build the launch.exe bridge:  dotnet build bin/bridge.csproj -c Release
     net40 because Proton ships wine-mono, which runs .NET Framework assemblies;
     x86 and a console subsystem to match what VRChat's own launcher is. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <!-- Not cosmetic: this name lands in the binary's string heap, and it is what
         the first build's bridges are recognised by. Keep it. -->
    <AssemblyName>launch_bridge_ready</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>obj/out/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="vrc-launch-bridge.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" />
  </ItemGroup>
</Project>
